# Hermes owns its provider credentials. No model API key belongs in AgentOS.
# HERMES_ROOT=/home/you/.hermes
# HERMES_BIN=hermes
# AGENTOS_PORT=4310
# AGENTOS_WORKSPACE=/absolute/path/to/your/workspace
# AGENTOS_DATA_DIR=/absolute/path/to/agentos-data
# AGENTOS_MAX_CONCURRENT=3
# AGENTOS_RUN_TIMEOUT_MS=900000
